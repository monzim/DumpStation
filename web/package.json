{
  "name": "dumpstation-web",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "scripts": {
    "dev": "vite --port 7511",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 7511",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "theme:build": "astryx theme build src/theme/black.ts --out src/theme/built/black.css",
    "theme:check": "astryx theme build src/theme/black.ts --out src/theme/built/black.css --check"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.17",
    "@astryxdesign/theme-neutral": "0.7.17",
    "@marsidev/react-turnstile": "^1.4.0",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-query": "^5.100.5",
    "@tanstack/react-router": "^1.132.0",
    "cronstrue": "^3.3.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.544.0",
    "mermaid": "^11.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.17",
    "@tanstack/router-plugin": "^1.132.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@11.5.3"
}
