# ============================================
# DumpStation Production Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env
# ============================================

# ============================================
# PostgreSQL Database (DumpStation Internal)
# ============================================
POSTGRES_DB=backup_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
# Keep the major version your data volume was created with (v1 used 15).
POSTGRES_IMAGE_TAG=15-alpine

# ============================================
# JWT Configuration
# ============================================
# Generate a secure secret: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET_HERE
# 30-minute sliding session; the frontend auto-refreshes while the user is
# active. Absolute cap is 12 hours regardless of refreshes.
JWT_EXPIRATION_MINUTES=30

# ============================================
# At-Rest Encryption (required)
# ============================================
# 32-byte AES key, base64-encoded. Generate with: openssl rand -base64 32
# Encrypts database passwords, storage keys, webhook URLs, TOTP secrets and
# DB Explorer credentials. WARNING: losing this key makes them unrecoverable.
DUMPSTATION_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_-base64_32

# ============================================
# Public URL (required for agents)
# ============================================
# The URL browsers and DumpStation Agents use to reach this server. Agents
# connect outbound to it over HTTPS; it appears in agent deployment commands.
PUBLIC_URL=https://dumpstation.yourdomain.com

# ============================================
# Discord sign-in codes (optional)
# ============================================
# Sign-in codes (and system notices) are posted to this webhook. Without it
# codes are written to the server log. Per-database notifications are
# configured in the UI (Notifications page).
DISCORD_WEBHOOK_URL=
OTP_EXPIRATION_MINUTES=5

# ============================================
# GitHub OAuth (Optional, single-user allow-list)
# ============================================
# When all four variables are set, the login page shows a "Sign in with
# GitHub" button. The callback only accepts the GitHub login listed in
# GITHUB_ALLOWED_LOGIN. Leave blank to keep using Discord-OTP only.
#
# 1. Create an OAuth app at https://github.com/settings/developers
# 2. Set the Authorization callback URL to:
#    https://dumpstation.yourdomain.com/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_LOGIN=your-github-username
GITHUB_REDIRECT_URL=https://dumpstation.yourdomain.com/api/v1/auth/github/callback
# The web UI is served by the same server, so WEB_ORIGIN defaults to PUBLIC_URL.

# ============================================
# Telegram Notifications
# ============================================
# Telegram bot tokens and chat IDs are configured PER notification config
# in the Notifications page — there is no global env var. To get a token,
# message @BotFather; to get a chat id, message @userinfobot (1:1 chat)
# or add the bot to a group and check getUpdates.

# ============================================
# Cloudflare Turnstile (Optional Bot Protection)
# ============================================
# Get keys from: https://dash.cloudflare.com/?to=/:account/turnstile
# Test keys (for development):
#   Site Key (always passes): 1x00000000000000000000AA
#   Secret Key: 1x0000000000000000000000000000000AA
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_TIMEOUT=5

# ============================================
# CORS (only needed if another origin calls the API)
# ============================================
# The web UI is served from the same origin, so CORS is not required.
# CORS_ALLOWED_ORIGINS=https://tools.yourdomain.com

# ============================================
# System Admin User
# ============================================
SYSTEM_USERNAME=admin
SYSTEM_EMAIL=admin@yourdomain.com

# ============================================
# Ports and execution
# ============================================
DUMPSTATION_PORT=8080
# Concurrent backups/restores run by the server itself (direct mode)
BACKUP_CONCURRENCY=2
# How long agent jobs wait for an offline agent before failing
AGENT_JOB_QUEUE_TTL_MINUTES=360
# Optional: restrict direct (server-side) connections to these networks,
# e.g. 10.0.0.0/8,192.168.10.0/24. Empty = any host.
DIRECT_ALLOWED_CIDRS=
# Set true only behind a reverse proxy you control (X-Forwarded-For)
TRUST_PROXY_HEADERS=false

# ============================================
# Production Deployment Notes
# ============================================
# 1. SECURITY:
#    - Change ALL passwords and secrets
#    - Use strong, randomly generated values
#    - Never commit .env file to version control
#
# 2. REVERSE PROXY:
#    - Recommended: Use Nginx/Caddy/Traefik in front
#    - Enable SSL/TLS (Let's Encrypt)
#    - Set PUBLIC_URL to the external HTTPS URL
#
# 3. BACKUPS:
#    - DumpStation database should also be backed up
#    - Consider automated snapshots of postgres_data volume
#
# 4. MONITORING:
#    - Check container logs: docker-compose logs -f
#    - Monitor disk space for volumes
#    - Set up health check alerts
#
# 5. UPDATES:
#    - Pull latest images: docker-compose pull
#    - Recreate containers: docker-compose up -d
#    - No downtime with proper health checks
# ============================================
