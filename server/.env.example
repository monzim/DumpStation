# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database Configuration (System Database)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=backup_service
DB_SSLMODE=disable

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
# 30-min sliding session, 12h absolute cap. Frontend silently refreshes
# while the user is active and surfaces a "Stay signed in" toast when idle.
JWT_EXPIRATION_MINUTES=30

# GitHub OAuth (optional). Set all four to enable a "Sign in with GitHub"
# button on the login page. The backend only accepts GITHUB_ALLOWED_LOGIN.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_LOGIN=
GITHUB_REDIRECT_URL=
# Where the web UI lives (defaults to PUBLIC_URL). Only needed when the UI is
# served from another origin, e.g. the Vite dev server (http://localhost:7511).
WEB_ORIGIN=

# External URL of this server; used in agent deployment commands.
PUBLIC_URL=http://localhost:8080
# Serve the built web UI (pnpm build in ../web) from the server.
WEB_DIR=../web/dist

# At-rest encryption key for configuration secrets (required).
# MUST be 32 raw bytes, base64-encoded. Generate with: openssl rand -base64 32
DUMPSTATION_SECRET_KEY=

# Discord webhook for sign-in codes (optional; without it codes are logged)
DISCORD_WEBHOOK_URL=
OTP_EXPIRATION_MINUTES=5

# Cloudflare Turnstile (optional bot protection on the sign-in form)
# Test keys: https://developers.cloudflare.com/turnstile/reference/testing/
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_TIMEOUT=5

# cors allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:7511
CORS_DEBUG=true


# this is the default system user created at startup with admin privileges
SYSTEM_USERNAME=root
SYSTEM_EMAIL=root@dumpstation.monzim.com